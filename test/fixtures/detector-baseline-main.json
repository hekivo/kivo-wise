  "radicle": {
    "runner": "lando",
    "runners": {
      "wp": "lando wp",
      "acorn": "lando acorn",
      "composer": "lando composer",
      "node": "lando npm",
      "test": "lando pest",
      "lint": null,
      "cache": "lando flush",
      "build": null,
      "dev": null,
      "login": null,
      "logs": "lando logs -s appserver -s appserver_nginx"
    },
    "lando": {
      "files": [
        ".lando.yml"
      ],
      "name": "radicle-demo",
      "recipe": "wordpress",
      "webroot": "public",
      "php": "8.4",
      "via": "nginx",
      "database": "mariadb",
      "xdebug": true,
      "composerVersion": false,
      "configFiles": {},
      "webService": "appserver_nginx",
      "envFile": [
        ".env",
        ".env.lando"
      ],
      "misplacedEnvFile": false,
      "excludes": [
        "vendor",
        "node_modules"
      ],
      "services": {
        "appserver": {
          "type": null,
          "image": null,
          "ports": []
        },
        "assets": {
          "type": "node:22",
          "image": "node:24-bookworm",
          "ports": [
            "5180:5180"
          ]
        },
        "database": {
          "type": "mariadb:11.4",
          "image": null,
          "ports": []
        },
        "redis": {
          "type": "redis:7",
          "image": null,
          "ports": []
        },
        "appserver_nginx": {
          "type": "nginx",
          "image": null,
          "ports": []
        }
      },
      "tooling": {
        "npm": {
          "service": "assets",
          "cmd": "npm",
          "dir": null,
          "description": null
        },
        "vite": {
          "service": "assets",
          "cmd": "npm run dev",
          "dir": null,
          "description": "Start Vite with hot reload"
        },
        "acorn": {
          "service": "appserver",
          "cmd": "wp acorn",
          "dir": null,
          "description": null
        },
        "flush": {
          "service": "appserver",
          "cmd": "wp cache flush && wp acorn optimize:clear && wp rewrite flush && redis-cli FLUSHALL",
          "dir": "/app",
          "description": "Clear WordPress, Acorn and Redis caches"
        },
        "pest": {
          "service": "appserver",
          "cmd": "vendor/bin/pest",
          "dir": "/app",
          "description": "Run tests with Pest"
        }
      },
      "events": [],
      "proxy": {},
      "parseErrors": []
    },
    "warnings": []
  },
