{
  "composer-mu-plugin": {
    "runner": "lando",
    "runners": {
      "wp": "lando wp",
      "acorn": "lando wp acorn",
      "composer": "lando composer",
      "node": "lando yarn",
      "test": "lando phpunit",
      "lint": "lando pint-check",
      "cache": "lando cache-clear",
      "build": null,
      "dev": null,
      "login": "lando login",
      "logs": "lando logs -s appserver -s appserver_nginx"
    },
    "lando": {
      "files": [
        ".lando.yml"
      ],
      "name": "demo",
      "recipe": "wordpress",
      "webroot": ".",
      "php": "8.4",
      "via": "nginx",
      "database": "mysql",
      "xdebug": true,
      "composerVersion": null,
      "configFiles": {
        "php": "./server/php/php.ini"
      },
      "webService": "appserver_nginx",
      "envFile": [],
      "misplacedEnvFile": true,
      "excludes": [],
      "services": {
        "appserver": {
          "type": null,
          "image": null,
          "ports": []
        },
        "redis": {
          "type": "redis:6",
          "image": null,
          "ports": []
        },
        "appserver_nginx": {
          "type": "nginx",
          "image": null,
          "ports": []
        },
        "database": {
          "type": "mysql",
          "image": null,
          "ports": []
        }
      },
      "tooling": {
        "yarn": {
          "service": "appserver",
          "cmd": "yarn",
          "dir": null,
          "description": null
        },
        "pint-check": {
          "service": "appserver",
          "cmd": "pint --test wp-content/mu-plugins/acme-core",
          "dir": null,
          "description": "Check code style without fixing"
        },
        "cache-clear": {
          "service": "appserver",
          "cmd": "bash scripts/clear-cache.sh",
          "dir": "/app",
          "description": null
        },
        "phpunit": {
          "service": "appserver",
          "cmd": "php /app/vendor/bin/phpunit --configuration /app/wp-content/mu-plugins/acme-core/phpunit.xml.dist",
          "dir": null,
          "description": null
        },
        "build:fast": {
          "service": "appserver",
          "cmd": "bash scripts/build-all.sh --skip-install",
          "dir": null,
          "description": null
        },
        "login": {
          "service": "appserver",
          "cmd": "wp plugin is-active wp-cli-login-server || wp login install --activate --yes; wp login as admin",
          "dir": null,
          "description": null
        }
      },
      "events": [
        "pre-start",
        "post-start"
      ],
      "proxy": {},
      "parseErrors": []
    },
    "warnings": [
      ".lando.yml: config.env_file is ignored by Lando; env_file belongs at the top level",
      "wp-content/mu-plugins/acme-core: resources/views outside the theme with roots/acorn 6.2.0 and WordPress 7.1.3; WordPress >= 7.1.2 rejects template paths outside the theme unless Acorn restores them (6.3.0 ships that filter), verify how views are rendered"
    ]
  },
