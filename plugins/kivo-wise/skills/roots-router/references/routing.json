{
  "$comment": "Profile x intent routing for the Roots stack. `profiles` describes what differs per profile; `intents` map user intent to one skill (`profiles: [\"*\"]` = every profile). `planned` lists skills named here whose folder does not ship yet; remove a name when its skill lands. `routes` is the compact list the session-start hook prints.",
  "routes": [
    {
      "skill": "roots-triage",
      "use": "detect profile, layout, runners; write .roots-stack.json"
    },
    {
      "skill": "roots-router",
      "use": "pick the skill by profile x intent"
    },
    {
      "skill": "acorn-stack",
      "use": "providers, composers, Blade, Application::configure, base path, optimize:clear"
    },
    {
      "skill": "acorn-scaffolding",
      "use": "make:* blocks, CPTs, providers, composers, components"
    },
    {
      "skill": "acf-native",
      "use": "ACF fields, validation, save flow, JS API (native first)"
    },
    {
      "skill": "acorn-livewire",
      "use": "Livewire 4 components, wire:model, 419, snapshots"
    },
    {
      "skill": "acorn-routes-api",
      "use": "Acorn routes vs register_rest_route, middleware, OpenAPI"
    },
    {
      "skill": "acorn-data",
      "use": "Eloquent, migrations, factories"
    },
    {
      "skill": "acorn-background",
      "use": "queues, WP-Cron, Action Scheduler, commands, logging, Redis"
    },
    {
      "skill": "wp-hooks-lifecycle",
      "use": "hook timing, mu-plugin load order"
    },
    {
      "skill": "wp-security-escaping",
      "use": "escaping, nonces, capabilities, prepared SQL"
    },
    {
      "skill": "lando-wp",
      "use": "run wp/composer/node/tests through Lando; rebuild vs restart; certs, DNS"
    },
    {
      "skill": "wp-composer-plugins",
      "use": "install or update plugins with Composer"
    },
    {
      "skill": "roots-debugging",
      "use": "500s, blank pages, Blade/ACF/Livewire/asset failures"
    },
    {
      "skill": "tailwind-vite-assets",
      "use": "Tailwind 4, Vite, Vite::asset, build base"
    },
    {
      "skill": "testing-wp",
      "use": "PHPUnit, Pest, Playwright"
    },
    {
      "skill": "wp-performance",
      "use": "profiling, slow queries, object cache"
    },
    {
      "skill": "wp-phpstan",
      "use": "PHPStan, larastan, baselines"
    },
    {
      "skill": "wp-abilities-mcp",
      "use": "Abilities API, MCP adapter, acorn-ai"
    },
    {
      "skill": "docs-brain",
      "use": "versioned official docs corpus lookup"
    },
    {
      "skill": "roots-onboarding",
      "use": "read-only project map"
    },
    {
      "skill": "roots-reviewing",
      "use": "convention audit per profile"
    }
  ],
  "profiles": {
    "sage-theme": {
      "label": "Sage theme (Acorn booted from the theme)",
      "appPath": "the theme directory (plain WordPress: wp-content/themes/<theme>; Bedrock: web/app/themes/<theme>)",
      "boot": "functions.php at include time",
      "basePath": "theme directory, inferred by Acorn",
      "namespace": "App\\",
      "blocks": "ACF Composer classes when log1x/acf-composer is installed, otherwise native register_block_type",
      "postTypes": "Poet (config/poet.php) or app/PostTypes classes",
      "views": "resources/views inside the theme",
      "assets": "public/build in the theme, served through Vite::asset",
      "protected": [
        ".env*",
        "wp-config.php",
        "vendor/",
        "node_modules/",
        "public/build/"
      ]
    },
    "acorn-mu-plugin": {
      "label": "Acorn application in a must-use plugin",
      "appPath": "wp-content/mu-plugins/<plugin> (read the exact path from the triage output)",
      "boot": "the main plugin file, usually on after_setup_theme",
      "basePath": "the plugin directory; it must be set explicitly (ACORN_BASEPATH or Application::configure(<path>)), otherwise Acorn may infer a theme that has a composer.json",
      "namespace": "project-specific; read apps[].namespace from the triage output",
      "blocks": "ACF Composer classes when log1x/acf-composer is installed, otherwise native register_block_type",
      "postTypes": "Poet, or classes under the app's PostTypes folder, registered by a provider or configurator",
      "views": "the plugin's resources/views, registered by its own providers (theme template filters do not apply)",
      "assets": "the plugin's public/build; URLs come from the plugin URL, not the theme",
      "protected": [
        ".env*",
        "wp-config.php",
        "the core directory",
        "vendor/",
        "node_modules/",
        "Composer-installed plugins/ and themes/",
        "uploads/",
        "public/build/"
      ]
    },
    "radicle-app": {
      "label": "Radicle (Acorn application at the repository root)",
      "appPath": ". (repository root)",
      "boot": "root bootstrap through the mu-plugin boot file under public/content/mu-plugins/",
      "basePath": "repository root",
      "namespace": "App\\",
      "blocks": "native register_block_type with the project's own block generator",
      "postTypes": "roots/acorn-post-types (config/post-types.php, Extended CPTs arguments)",
      "views": "resources/views at the repository root",
      "assets": "public/build at the webroot",
      "protected": [
        ".env*",
        "bedrock/environments/*.php (ask before editing: it is the real configuration)",
        "public/wp-config.php",
        "public/index.php",
        "public/content/mu-plugins/00-acorn-boot.php",
        "vendor/",
        "node_modules/"
      ]
    }
  },
