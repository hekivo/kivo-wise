{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "kind", "run_id", "generated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "inventory" },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "http": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "integer" },
        "location": { "type": "string" },
        "ms": { "type": "integer" },
        "error": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "proposed", "reason", "rule_id"],
      "properties": {
        "path": { "type": "string", "pattern": "^(/|https?://)" },
        "origin": { "enum": ["sitemap", "search", "both"] },
        "sitemap": { "type": "string" },
        "type": { "type": "string" },
        "lastmod": { "type": ["string", "null"] },
        "live": { "$ref": "#/$defs/http" },
        "staging": { "$ref": "#/$defs/http" },
        "title": { "type": "string" },
        "h1": { "type": "string" },
        "canonical": { "type": "string" },
        "robots": { "type": "string" },
        "clicks": { "type": ["integer", "null"] },
        "impressions": { "type": ["integer", "null"] },
        "position": { "type": ["number", "null"] },
        "sessions": { "type": ["integer", "null"] },
        "proposed": { "enum": ["keep", "redirect", "gone", "noindex", "review"] },
        "reason": { "type": "string" },
        "rule_id": { "type": "string", "pattern": "^R\\d{2}$" },
        "final": { "type": ["string", "null"], "enum": ["keep", "redirect", "gone", "noindex", null] },
        "target": { "type": "string" },
        "decided_by": { "type": "string" },
        "note": { "type": "string" },
        "issue": { "type": "integer" }
      }
    }
  }
}
